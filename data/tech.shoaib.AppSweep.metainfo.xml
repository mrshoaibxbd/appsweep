<component type="desktop-application">
  <id>tech.shoaib.AppSweep</id>
  <name>AppSweep</name>
  <summary>Safely remove applications and associated data</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <description>
    <p>
      AppSweep provides a native interface for reviewing and removing
      applications installed through APT, Snap, and Flatpak.
    </p>
    <p>
      It analyzes removal effects, protects critical system components,
      detects application data, and supports verified rollback backups.
    </p>
  </description>

