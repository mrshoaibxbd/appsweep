#!/usr/bin/python3

import argparse
import json
import os
import re
import subprocess
from pathlib import Path

PACKAGE_PATTERN = re.compile(r"^[a-z0-9][a-z0-9+.-]*(?::[a-z0-9][a-z0-9-]*)?$")
SNAP_PATTERN = re.compile(r"^[a-z0-9][a-z0-9-]*$")

LOCK_PATHS = (
    Path("/var/lib/dpkg/lock"),
    Path("/var/lib/dpkg/lock-frontend"),
    Path("/var/lib/apt/lists/lock"),
    Path("/var/cache/apt/archives/lock"),
)

PROTECTED_PACKAGES = frozenset(
    {
        "apt",
        "bash",
        "coreutils",
        "dbus",
        "dpkg",
        "gdm3",
        "gnome-control-center",
        "gnome-shell",
        "grub-common",
        "grub-pc",
        "grub-pc-bin",
        "libc6",
        "linux-generic",
        "linux-image-generic",
        "nautilus",
        "network-manager",
        "nm-connection-editor",
        "policykit-1",
        "polkitd",
        "sudo",
        "systemd",
        "systemd-sysv",
        "ubuntu-desktop",
        "ubuntu-desktop-minimal",
        "util-linux",
    }
)

PROTECTED_PACKAGE_PREFIXES = (
    "linux-image-",
    "linux-modules-",
    "linux-headers-",
    "grub-",
    "shim-",
)

PROTECTED_SNAPS = frozenset(
    {
        "snapd",
        "bare",
        "core",
        "core18",
        "core20",
        "core22",
        "core24",
        "gtk-common-themes",
    }
)

PROTECTED_SNAP_PREFIXES = (
    "gnome-",
    "desktop-security-center",
)

ENVIRONMENT = {
    "PATH": "/usr/sbin:/usr/bin:/sbin:/bin",
    "HOME": "/root",
    "LC_ALL": "C",
    "DEBIAN_FRONTEND": "noninteractive",
}


def emit(success: bool, message: str, **details: object) -> None:
    print(
        json.dumps(
            {
                "success": success,
                "message": message,
                **details,
            }
        )
    )


def validate_environment() -> None:
    if os.geteuid() != 0:
        raise PermissionError("This helper must run with administrative privileges.")

    if os.environ.get("PKEXEC_UID") is None:
        raise PermissionError("This helper must be started through PolicyKit.")


def validate_package_name(package_name: str) -> None:
    if not PACKAGE_PATTERN.fullmatch(package_name):
        raise ValueError("Invalid package name.")

    normalized = package_name.split(":", 1)[0]

    if normalized in PROTECTED_PACKAGES or normalized.startswith(
        PROTECTED_PACKAGE_PREFIXES
    ):
        raise ValueError("AppSweep refuses to remove protected system packages.")


def validate_snap_name(snap_name: str) -> None:
    if not SNAP_PATTERN.fullmatch(snap_name):
        raise ValueError("Invalid Snap name.")

    if snap_name in PROTECTED_SNAPS or snap_name.startswith(PROTECTED_SNAP_PREFIXES):
        raise ValueError("AppSweep refuses to remove protected Snap components.")


def package_is_installed(package_name: str) -> bool:
    result = subprocess.run(
        [
            "/usr/bin/dpkg-query",
            "-W",
            "-f=${db:Status-Abbrev}",
            package_name,
        ],
        capture_output=True,
        text=True,
        check=False,
        env=ENVIRONMENT,
    )

    return result.returncode == 0 and result.stdout.startswith("ii")


def snap_is_installed(snap_name: str) -> bool:
    result = subprocess.run(
        ["/usr/bin/snap", "list", snap_name],
        capture_output=True,
        text=True,
        check=False,
        env=ENVIRONMENT,
    )

    return result.returncode == 0


def apt_is_locked() -> bool:
    for path in LOCK_PATHS:
        result = subprocess.run(
            ["/usr/bin/fuser", str(path)],
            capture_output=True,
            check=False,
            env=ENVIRONMENT,
        )

        if result.returncode == 0:
            return True

    return False


def purge_package(package_name: str) -> int:
    validate_package_name(package_name)

    if not package_is_installed(package_name):
        emit(False, f"Package '{package_name}' is not installed.")
        return 3

    if apt_is_locked():
        emit(False, "APT or dpkg is currently busy.")
        return 4

    result = subprocess.run(
        [
            "/usr/bin/apt-get",
            "--assume-yes",
            "--purge",
            "--no-install-recommends",
            "remove",
            package_name,
        ],
        capture_output=True,
        text=True,
        check=False,
        env=ENVIRONMENT,
    )

    if result.returncode != 0:
        emit(
            False,
            "APT could not remove the package.",
            stdout=result.stdout,
            stderr=result.stderr,
            exit_code=result.returncode,
        )
        return result.returncode

    emit(
        True,
        f"Package '{package_name}' was purged successfully.",
        stdout=result.stdout,
    )
    return 0


def remove_snap(snap_name: str, purge: bool) -> int:
    validate_snap_name(snap_name)

    if not snap_is_installed(snap_name):
        emit(False, f"Snap '{snap_name}' is not installed.")
        return 3

    command = ["/usr/bin/snap", "remove", snap_name]

    if purge:
        command.append("--purge")

    result = subprocess.run(
        command,
        capture_output=True,
        text=True,
        check=False,
        env=ENVIRONMENT,
    )

    if result.returncode != 0:
        emit(
            False,
            "Snap could not remove the application.",
            stdout=result.stdout,
            stderr=result.stderr,
            exit_code=result.returncode,
        )
        return result.returncode

    message = (
        f"Snap '{snap_name}' was removed without creating a new snapshot."
        if purge
        else f"Snap '{snap_name}' was removed and Snap created a rollback snapshot."
    )

    emit(True, message, stdout=result.stdout)
    return 0


def parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="appsweep-helper")

    operations = parser.add_mutually_exclusive_group(required=True)
    operations.add_argument("--version", action="store_true")
    operations.add_argument("--purge", metavar="PACKAGE")
    operations.add_argument("--remove-snap", metavar="SNAP")
    operations.add_argument("--purge-snap", metavar="SNAP")

    return parser.parse_args()


def main() -> int:
    try:
        validate_environment()
        arguments = parse_arguments()

        if arguments.version:
            emit(True, "AppSweep helper 0.2.0")
            return 0

        if arguments.purge:
            return purge_package(arguments.purge)

        if arguments.remove_snap:
            return remove_snap(arguments.remove_snap, purge=False)

        return remove_snap(arguments.purge_snap, purge=True)
    except (PermissionError, ValueError) as error:
        emit(False, str(error))
        return 2
    except Exception as error:
        emit(False, f"Unexpected helper error: {error}")
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
